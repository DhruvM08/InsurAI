# ==========================================
# InsurAI — Comprehensive .gitignore
# ==========================================

# Compiled Class Files & Packages
*.class
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Log files & Crash dumps
*.log
logs/
LogFiles/
hs_err_pid*
replay_pid*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
target/
**/target/
build/
dist/
**/dist/
dist-ssr/
*.local

# Dependencies
node_modules/
**/node_modules/

# IDE & Editor Configs
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.zencoder/

# Confidential / Secrets (Protected from Git)
.env
.env.*
!.env.example
*.env
*.env.local
http-client.private.env.json
**/http-client.private.env.json
backend/src/main/resources/application.properties
backend/src/main/resources/application-*.properties
!backend/src/main/resources/application.properties.example
